# SpaceSlimmer Backend Environment Variables
NODE_ENV=development
AWS_REGION=us-east-2
STAGE=dev

# JWT Secret for signing tokens (Must be kept secure in production)
JWT_SECRET=spaceslimmer-jwt-secret-key-2026-production-token

# Optional Frontend / App CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost
