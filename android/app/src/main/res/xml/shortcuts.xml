<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="compress"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_crop"
        android:shortcutShortLabel="@string/shortcut_compress">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.spaceslimmer.app"
            android:targetClass="com.spaceslimmer.app.MainActivity">
            <extra
                android:name="com.spaceslimmer.app.extra.OPEN"
                android:value="compress" />
        </intent>
    </shortcut>
    <shortcut
